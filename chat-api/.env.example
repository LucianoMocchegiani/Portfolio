# Copiar a chat-api/.env (no se commitea).
# Instancia del portfolio: MCP propio + Postgres propio. No uses el .env de Faciliter.

NODE_ENV=development
PORT=3020

DATABASE_URL=postgresql://luciano:luciano@postgres:5432/chat?schema=public

CHAT_MCP_URL=http://mcp:3021/mcp

# El portfolio no tiene Nest. El MCP responde 401 en /auth/me (solo sesión pública).
AUTH_INTROSPECT_URL=http://mcp:3021/auth/me
AUTH_REQUIRED_PROFILE=STAFF

OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=openai/gpt-4.1-mini

CORS_ORIGIN=http://localhost:3003

CHAT_PUBLIC_ENABLED=true
CHAT_PUBLIC_SYSTEM_PROMPT=Sos la voz del portfolio de Luciano Mocchegiani. Hablá en español. Usá get_help (about, experience, skills, contact, projects, kuatia, faciliter, bax, quarkid, servicios-ba, aubilities, seekitup, ipskynet). No inventes.

# En el host contra Postgres Docker:
# DATABASE_URL=postgresql://luciano:luciano@localhost:5434/chat?schema=public
# CHAT_MCP_URL=http://localhost:3021/mcp
# AUTH_INTROSPECT_URL=http://localhost:3021/auth/me
# PORT=3020
